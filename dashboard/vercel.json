{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "regions": ["iad1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/calendar-normalize.js,server/calendar-normalize-bounded.js,server/calendar-normalize-worker.js,node_modules/ical.js/**,node_modules/@js-temporal/polyfill/**,node_modules/jsbi/**}"
    }
  },
  "redirects": [
    { "source": "/", "destination": "/family.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=:path" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/mobile/jobs/notifications", "schedule": "* * * * *" },
    { "path": "/api/calendar/jobs/sync", "schedule": "*/5 * * * *" },
    { "path": "/api/internet/jobs/process", "schedule": "* * * * *" }
  ]
}
