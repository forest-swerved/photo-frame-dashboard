{
  "name": "home-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test family/js/*.test.js server/backend.test.js server/calendar-normalize.test.js server/calendar-normalize-bounded.test.js server/icloud-caldav.test.js",
    "test:db": "FAMILY_RUN_DB_TESTS=1 node --env-file=.env.test.local --test server/backend.integration.test.js",
    "db:migrate": "node --env-file=.env.local server/migrate.js",
    "db:verify": "node --env-file=.env.local server/verify-schema.js",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "ical.js": "2.2.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "tsdav": "2.4.0"
  }
}
