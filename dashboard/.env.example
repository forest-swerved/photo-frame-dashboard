# Obtain these from the dedicated family dashboard Supabase project.
# Never use another project's database or paste real values into source control.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase database CA as PEM; strict certificate and hostname validation stays on.
SUPABASE_DB_CA_CERT=

# Standard base64 encoding of 32 random bytes; server only.
FAMILY_ENCRYPTION_KEY=
# SHA-256 hex of the private, one-use household setup code; server only.
FAMILY_BOOTSTRAP_HASH=
# Optional confirmed owner account UUID; bind short setup PINs to this account.
FAMILY_BOOTSTRAP_USER_ID=

# Server-only notification worker secret: at least 32 random characters.
CRON_SECRET=
# Apple Developer APNs token key. Never place the .p8 private key in the iOS app.
FAMILY_APNS_TEAM_ID=
FAMILY_APNS_KEY_ID=
FAMILY_APNS_PRIVATE_KEY=
FAMILY_APNS_TOPIC=com.swerved.familyframe
